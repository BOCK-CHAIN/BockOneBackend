# PostgreSQL connection string
# Local example:  postgresql://postgres:yourpassword@localhost:5432/bockone
# AWS RDS example: postgresql://user:pass@your-rds-endpoint.amazonaws.com:5432/dbname
DATABASE_URL=''

# AWS credentials (only required for profile photo upload via S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET=

# CloudFront distribution URL for serving profile photos (e.g. https://abc123.cloudfront.net)
CLOUDFRONT_URL=

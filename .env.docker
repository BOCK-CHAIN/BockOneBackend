# Docker Development - Environment Variables
# Copy this file to .env.docker.local and fill in your values

# AWS RDS PostgreSQL Connection String
# Format: postgresql://username:password@hostname:5432/database
DATABASE_URL="postgresql://bockone_user:your-password@your-db-host:5432/bockone_db?sslmode=require"

# AWS S3 Credentials (optional for profile photo uploads)
AWS_ACCESS_KEY_ID="your-aws-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="your-s3-bucket"
CLOUDFRONT_URL="https://your-cloudfront-domain.cloudfront.net"

# Backend
NODE_ENV=development
PORT=3000
